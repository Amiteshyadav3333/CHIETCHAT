# Local development only. Production values belong in the hosting dashboard.
APP_ENV=development
SECRET_KEY=replace-with-a-random-value
JWT_SECRET_KEY=replace-with-a-different-random-value
DATABASE_URL=sqlite:///db.sqlite
FRONTEND_URL=http://127.0.0.1:5173
BACKEND_URL=http://127.0.0.1:5000

# Admin dashboard: set all five values in your hosting dashboard. Do not use
# the sample values as production credentials.
ADMIN_NAME=
ADMIN_EMAIL=
ADMIN_PHONE=
ADMIN_PASSWORD_HASH=
ADMIN_ACCESS_CODE=

# Required in production
SUPABASE_URL=
SUPABASE_ANON_KEY=
REDIS_URL=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:ops@example.com
TURN_URLS=
# Managed TURN providers such as Metered.ca use fixed credentials:
TURN_USERNAME=
TURN_CREDENTIAL=
# Self-hosted coturn can use this shared secret instead of the two fields above:
TURN_SECRET=
DATA_RETENTION_PEPPER=

# Payments (checkout remains disabled unless all three are configured)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
PREMIUM_PRICE_PAISE=19900
PAYMENT_RETENTION_DAYS=2555

# Optional AI providers and search
GEMINI_API_KEY=

# Required in production: server-side image/video adult-content scoring.
SIGHTENGINE_API_USER=
SIGHTENGINE_API_SECRET=
ADULT_SCORE_THRESHOLD=0.90
CONTENT_MODERATION_REQUIRED=true
GROK_API_KEY=
GROQ_API_KEY=
OPENAI_API_KEY=
SERPER_API_KEY=

# Operations and observability
CALL_RECORD_RETENTION_DAYS=90
AI_MEMORY_RETENTION_DAYS=30
AI_MEMORY_MAX_ROWS=100
MAX_UPLOAD_BYTES=104857600
LOG_LEVEL=INFO
SENTRY_DSN=
SENTRY_TRACES_SAMPLE_RATE=0.05
SENTRY_PROFILES_SAMPLE_RATE=0.0
APP_RELEASE=
BACKUP_SIGNING_KEY=
PODLIVE_URL=https://podlive-sigma.vercel.app
PODLIVE_API_URL=https://podlive-api-18as.onrender.com
